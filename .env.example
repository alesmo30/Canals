# Copy to .env for local development outside Docker. docker-compose.yml
# (added in step 11) injects these directly via `environment:` and never
# reads this file — see infrastructure.md §5 for the values it uses there.
#
# The app validates every one of these against src/infrastructure/config/env.schema.ts
# at boot and refuses to start if any is missing or malformed (R0.3).

# Postgres connection string. Must use the postgres:// or postgresql:// scheme.
# In compose, host resolves to the `postgres` service; locally, use localhost.
DATABASE_URL=postgres://canals:canals@localhost:5432/canals

# HTTP port for the api entrypoint (main.ts). Unused by the worker.
PORT=3000

# Base URL of the payments-mock service (added in P2 / docker-compose.yml).
PAYMENTS_URL=http://localhost:4000

# Geocoding adapter to use: "static" (P0/P1 default, no external calls) or
# "geoapify" (P2, requires GEOAPIFY_API_KEY).
GEOCODING_DRIVER=static

# Required only when GEOCODING_DRIVER=geoapify. Leave unset for the static
# driver.
GEOAPIFY_API_KEY=

# OTLP endpoint the api and worker export traces/metrics to (the `lgtm`
# service, added in P3 / docker-compose.yml).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# How often the worker polls pg-boss for jobs, in seconds. See
# infrastructure.md §7, "Decided configuration: 15 s poll + LISTEN/NOTIFY".
PGBOSS_POLL_INTERVAL_SECONDS=15

# How long a stock reservation survives a PENDING_PAYMENT order before the
# worker's reaper releases it, in minutes. See architectural-requirements.md,
# Q-2.
RESERVATION_TTL_MINUTES=15

# Comma-separated list of origins allowed by CORS on the api. Unused by the
# worker. 5173 is the console's Vite dev server (SPEC 08, web/).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Pretty-print, colorized logs via pino-pretty. Local dev only — leave
# unset in docker-compose (and don't add it there): containers keep
# emitting raw JSON lines.
LOG_PRETTY=true
